+/// Delete local module records transactionally; Anki is intentionally untouched.
+/// Return PDF paths for cleanup after the successful database transaction.
+pub fn delete_module(db: &mut Connection, id: &str) -> Result<Vec<String>, String> {
+    let transaction = db.transaction().map_err(|e| e.to_string())?;
+    let found: i64 = transaction.query_row(
+        "SELECT COUNT(*) FROM modules WHERE id=?1", [id], |r| r.get(0)
+    ).map_err(|e| e.to_string())?;
+    if found == 0 { return Err("Modul nicht gefunden".into()); }
+    let paths = {
+        let mut stmt = transaction.prepare("SELECT local_path FROM documents WHERE module_id=?1")
+            .map_err(|e| e.to_string())?;
+        let iter = stmt.query_map([id], |r| r.get::<_, String>(0))
+            .map_err(|e| e.to_string())?;
+        iter.collect::<Result<Vec<_>, _>>().map_err(|e| e.to_string())?
+    };
+    transaction.execute("DELETE FROM cards WHERE module_id=?1", [id]).map_err(|e|e.to_string())?;
+    transaction.execute("DELETE FROM batches WHERE module_id=?1", [id]).map_err(|e|e.to_string())?;
+    transaction.execute("DELETE FROM documents WHERE module_id=?1", [id]).map_err(|e|e.to_string())?;
+    transaction.execute("DELETE FROM modules WHERE id=?1", [id]).map_err(|e|e.to_string())?;
+    transaction.commit().map_err(|e|e.to_string())?;
+    Ok(paths)
+}
